# Symmetric encryption key for securing tokens.json on persistent volumes.
# Docker Compose maps this into secret /run/secrets/nest_key for the collector.
# Generate any secure passphrase. Leave blank or comment out to run in plaintext.
# NEST_TOKEN_ENCRYPTION_KEY=your_symmetric_encryption_key_here

# Override the container heartbeat file path (Optional, default: /tmp/nestgraph2.lifecheck)
# LIFECHECK_FILE=/tmp/nestgraph2.lifecheck

# Frequency in seconds of container heartbeat touch (Optional, default: 3600)
# LIFECHECK_INTERVAL_SECONDS=3600
