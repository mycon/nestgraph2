{
  "_comment": "Copy this file to config.json and fill in your values. config.json is gitignored.",

  "nest": {
    "_comment_postal": "Postal code for your home — used for Nest's built-in weather endpoint.",
    "postal_code": "",
    "country_code": "US"
  },

  "influxdb": {
    "url": "http://127.0.0.1:8086",
    "token": "",
    "org": "myorg",
    "bucket": "nestgraph"
  },

  "weather": {
    "_comment": "Decimal degrees for your location. Used for Open-Meteo outdoor temp/humidity. Find at https://www.latlong.net/",
    "lat": null,
    "lon": null,
    "_comment_source": "outdoor_source: 'open_meteo' (free, no key, lat/lon required) or 'nest' (uses home.nest.com/api forecast, postal_code required).",
    "outdoor_source": "open_meteo"
  },

  "connect_nest": {
    "_comment": "Settings for data collection and token persistence.",
    "_comment_data_source": "Data source: 'foyer' (default, Google Home Foyer protobufs; Nest Observe disabled), 'auto' (Observe with Foyer fallback), or 'observe' (legacy Nest Observe only).",
    "data_source": "foyer",
    "foyer_poll_interval_sec": 30,
    "foyer_traits_poll_interval_sec": 300,
    "foyer_structure_mode_poll_interval_sec": 120,
    "cookie_rotate_interval_sec": 540,
    "_comment_observe_timeout": "Read timeout for legacy Observe stream in seconds (only used when data_source is 'auto' or 'observe').",
    "observe_timeout_sec": 7200,
    "token_refresh_margin_sec": 290,
    "_comment_token_file": "Path to the JSON file where session tokens are persisted. Inside a container, mount a volume here or point to /app/config/tokens.json.",
    "token_file": "config/tokens.json"
  },

  "settings": {
    "timezone": "America/New_York",
    "temp_units": "F",
    "mapping_sync_interval_seconds": 86400,
    "device_label_short_id_len": 6,
    "log_level": "INFO"
  }
}
